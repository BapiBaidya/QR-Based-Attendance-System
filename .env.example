# ==========================================
# Application Configuration
# ==========================================
ENVIRONMENT=development
DEBUG=True

# ==========================================
# Cryptography & JWT Security
# ==========================================
SECRET_KEY=change_this_to_a_secure_random_64_character_hex_secret_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==========================================
# Database (PostgreSQL)
# ==========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=attendance_db
POSTGRES_PORT=5432

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/attendance_db
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/attendance_db

# ==========================================
# Redis Cache & Nonce Store
# ==========================================
REDIS_URL=redis://localhost:6379/0

# ==========================================
# CORS Allowed Origins (JSON Array)
# ==========================================
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000"]
